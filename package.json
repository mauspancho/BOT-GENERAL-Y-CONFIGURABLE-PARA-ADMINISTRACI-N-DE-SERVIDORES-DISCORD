{
  "name": "discord-community-bot",
  "version": "0.1.0",
  "description": "Bot general, configurable y modular para administracion de comunidades Discord.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "setup": "tsx src/cli/setup.ts",
    "validate": "tsx src/cli/validate.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "backup": "tsx src/cli/backup.ts",
    "commands:register": "tsx src/cli/registerCommands.ts",
    "test": "vitest run tests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.1",
    "pino": "^10.3.1",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@10.9.0"
}
